# Copy to .env (or config.env) and fill in.

# MongoDB Atlas connection string. Leave blank to store data in server/data/db.json instead.
ATLAS_URI=
DB_NAME=FinanceTracker

# Long random string used to sign login tokens. Required when deployed.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Set to false after creating your own account so nobody else can sign up.
ALLOW_REGISTRATION=true

PORT=3000
